{
  "name": "jet-engine-lab",
  "version": "2.0.0-alpha.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "bun run docs:check && tsc --noEmit && vite build && bun scripts/generate-precache.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "bun test src/physics.test.js src/app/physics.test.ts src/app/maps.test.ts src/app/studio/project.test.ts src/app/data/catalog.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "bash scripts/deploy-pages.sh",
    "record": "bun scripts/record-website.mjs",
    "smoke": "bun scripts/smoke-visual-first.mjs && bun scripts/smoke-engine-gallery.mjs",
    "smoke:production": "bun scripts/smoke-production.mjs",
    "smoke:all": "bun scripts/smoke-production.mjs --all-browsers",
    "smoke:visual": "bun scripts/smoke-visual-first.mjs",
    "docs:check": "bun scripts/check-docs.mjs",
    "smoke:studio": "bun scripts/smoke-visual-first.mjs",
    "smoke:engines": "bun scripts/smoke-engine-gallery.mjs",
    "previews:engines": "bun scripts/capture-engine-previews.mjs",
    "cad:generate": "python3 scripts/generate-solidcraft-cad.py && blender -b -t 4 -P scripts/solidcraft-obj-to-glb.py",
    "smoke:cad": "bun scripts/smoke-solidcraft-cad.mjs",
    "smoke:cad:reveal": "bun scripts/smoke-cad-assembly-reveal.mjs",
    "smoke:cad:full": "bun scripts/smoke-solidcraft-full.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "vite": "^8.3.5",
    "typescript": "^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/bun": "^1.4.4",
    "@playwright/test": "^1.64.1"
  }
}
