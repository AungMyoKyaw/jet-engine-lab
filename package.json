{
  "name": "jet-engine-lab",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && bun scripts/generate-precache.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "bun test src/physics.test.js src/app/physics.test.ts src/app/maps.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "bash scripts/deploy-pages.sh",
    "record": "bun scripts/record-website.mjs",
    "smoke": "bun scripts/smoke-redesign.mjs",
    "smoke:production": "bun scripts/smoke-production.mjs",
    "smoke:all": "bun scripts/smoke-production.mjs --all-browsers",
    "smoke:visual": "bun scripts/verify-visual-workspace.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "katex": "^0.19.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.180.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "vite": "^8.3.5",
    "typescript": "^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/bun": "^1.4.4",
    "@playwright/test": "^1.64.1"
  }
}
